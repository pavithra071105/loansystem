{
  "services": {
    "frontend": {
      "root": "loan-eligibility/frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "loan-eligibility/backend",
      "entrypoint": "run:app"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}